# Fill these ONLY in Vercel's environment-variable settings.
# All keys must belong to your own NEW project, never the managed Lovable project.
EXTERNAL_SUPABASE_URL=
EXTERNAL_SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
SESSION_SECRET=
# Vercel normally supplies VERCEL=1 automatically.
# Never prefix private keys or passwords with VITE_.